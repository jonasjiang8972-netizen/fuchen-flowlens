# FlowLens POC settings. install.sh writes .env from this template with
# generated secrets; edit .env, then run ./flowlens-ctl.sh restart.
# Never commit or share the real .env.

# Image tag of flowlens-platform / flowlens-web / flowlens-agent
FLOWLENS_VERSION=1.0.0

# --- Secrets (install.sh generates them) -------------------------------
# Database password. Letters, digits and . _ ~ - only (it is part of a URL).
POSTGRES_PASSWORD=
# Shared secret agents send as X-Agent-Token (openssl rand -hex 32)
FLOWLENS_AGENT_TOKEN=
# Initial password of sysadmin / auditadmin / secadmin, first start only.
# At least 8 characters from 3 of: upper, lower, digit, symbol.
FLOWLENS_ADMIN_PASSWORD=

# --- Network ------------------------------------------------------------
FLOWLENS_BIND_ADDR=0.0.0.0
FLOWLENS_HTTP_PORT=8080
FLOWLENS_HTTPS_PORT=8443
# Subnet of the internal web<->platform network; change it only if it
# clashes with an existing network. Keep TRUSTED_PROXIES equal to it.
FLOWLENS_FRONTEND_SUBNET=172.30.10.0/24
FLOWLENS_TRUSTED_PROXIES=172.30.10.0/24
# Extra origins allowed to call the API cross-origin (comma-separated)
FLOWLENS_CORS_ORIGINS=

# --- HTTPS --------------------------------------------------------------
# true: serve the console on FLOWLENS_HTTPS_PORT with certs/server.crt and
# certs/server.key, redirect HTTP to HTTPS. Set COOKIE_SECURE to match.
FLOWLENS_WEB_HTTPS=false
FLOWLENS_COOKIE_SECURE=false

# --- Streaming backbone (optional, docker-compose.stream.yaml) -----------
# Password of the ClickHouse "flowlens" user. Letters and digits only.
CLICKHOUSE_PASSWORD=

# --- Enforcement / SOAR (optional, see docs/SOAR.md) ---------------------
# A connector is enabled by setting its URL. Start with DRY_RUN=true: blocks
# are then recorded but nothing is sent to your gateways.
FLOWLENS_SOAR_DRY_RUN=false
# Never block these addresses/networks (comma-separated), e.g. office egress
FLOWLENS_SOAR_PROTECTED_CIDRS=
FLOWLENS_SOAR_MAX_BLOCKS_PER_HOUR=
FLOWLENS_SOAR_KONG_URL=
FLOWLENS_SOAR_KONG_TOKEN=
FLOWLENS_SOAR_APISIX_URL=
FLOWLENS_SOAR_APISIX_KEY=
FLOWLENS_SOAR_WEBHOOK_URL=
FLOWLENS_SOAR_WEBHOOK_SECRET=
FLOWLENS_SOAR_ALIYUN_WAF_ACCESS_KEY_ID=
FLOWLENS_SOAR_ALIYUN_WAF_ACCESS_KEY_SECRET=
FLOWLENS_SOAR_ALIYUN_WAF_INSTANCE_ID=
FLOWLENS_SOAR_ALIYUN_WAF_TEMPLATE_ID=
FLOWLENS_SOAR_ALIYUN_WAF_REGION=

# --- Other --------------------------------------------------------------
FLOWLENS_TZ=Asia/Shanghai
# true: add sample assets, alerts and collectors to an empty database
FLOWLENS_SEED_DEMO=false
# Host directory with the gateway JSON access log (access.log) for the agent.
# Empty: use the demo generator's volume.
FLOWLENS_GATEWAY_LOG_DIR=
# Requests per second written by the demo traffic generator
FLOWLENS_DEMO_RATE=5
