# Copy to deploy/.env and fill in. Never commit the real .env.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
# Shared secret agents send as X-Agent-Token (generate: openssl rand -hex 32)
FLOWLENS_AGENT_TOKEN=
# Initial password for sysadmin / auditadmin / secadmin (first start only)
FLOWLENS_ADMIN_PASSWORD=
# true when the console is served over HTTPS
FLOWLENS_COOKIE_SECURE=false
